 #ifdef ASSERT
 volatile int CompiledICHolder::_live_count;
@@ -30,6 +33,31 @@
 volatile int CompiledICHolder::_live_count;
 volatile int CompiledICHolder::_live_not_claimed_count;
 #endif
+#if defined(__ANDROID__) && defined(__aarch64__)
+void* CompiledICHolder::operator new(size_t size) {
+  // Scoped Android compatibility: Bionic's top-byte heap tag cannot
+  // round-trip through the existing 48-bit AArch64 inline-cache encoding.
+  // mmap returns an untagged, page-backed pointer without allowing execution.
+  void* ptr = ::mmap(nullptr, size, PROT_READ | PROT_WRITE,
+                     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (ptr == MAP_FAILED) {
+    vm_exit_out_of_memory(size, OOM_MMAP_ERROR,
+                          "NeuroCenter CompiledICHolder mapping");
+  }
+  // Fail explicitly on a future kernel with addresses beyond the
+  // encoding's 48-bit range, rather than silently truncating them.
+  guarantee(((uintptr_t)ptr >> 48) == 0, "CompiledICHolder address >48 bits");
+  return ptr;
+}
+
+void CompiledICHolder::operator delete(void* ptr) {
+  if (ptr != nullptr) {
+    int status = ::munmap(ptr, sizeof(CompiledICHolder));
+    guarantee(status == 0, "CompiledICHolder unmap failed");
+  }
+}
+#endif
+
 
