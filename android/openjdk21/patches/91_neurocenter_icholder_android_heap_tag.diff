--- a/src/hotspot/share/oops/compiledICHolder.hpp
+++ b/src/hotspot/share/oops/compiledICHolder.hpp
@@ -56,6 +56,16 @@
   bool _is_metadata_method;
 
  public:
+#if defined(__ANDROID__) && defined(__aarch64__)
+  // AArch64's compiled inline caches store these holders in patchable
+  // 48-bit immediates. Bionic malloc returns top-byte-tagged pointers;
+  // losing that tag before FreeHeap/free() causes an Android abort.
+  // Allocate just these holders from an anonymous, non-executable mapping.
+  // Do not change global heap pointer tagging or the Android sandbox.
+  void* operator new(size_t size);
+  void operator delete(void* ptr);
+#endif
+
   // Constructor
   CompiledICHolder(Metadata* metadata, Klass* klass, bool is_method = true);
   ~CompiledICHolder() NOT_DEBUG_RETURN;
