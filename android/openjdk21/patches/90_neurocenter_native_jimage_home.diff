diff --git a/src/hotspot/os/linux/os_linux.cpp b/src/hotspot/os/linux/os_linux.cpp
--- a/src/hotspot/os/linux/os_linux.cpp
+++ b/src/hotspot/os/linux/os_linux.cpp
@@ -517,6 +517,17 @@ void os::init_system_properties_values() {
       }
     }
     Arguments::set_java_home(buf);
+#ifdef __ANDROID__
+    // NeuroCenter includes an immutable JIMAGE and the OpenJDK native
+    // libraries directly in the APK's nativeLibraryDir. A library at
+    // <APK>/lib/arm64/libjvm.so does not have the regular JDK hierarchy.
+    // The untrusted .ncapp runs in an Android isolated UID; never resolve
+    // JRE content from the host application's private files directory.
+    const char* nc_home = ::getenv("NEUROCENTER_JRE_HOME");
+    if (nc_home != nullptr && nc_home[0] != '\0') {
+      Arguments::set_java_home(nc_home);
+      Arguments::set_dll_dir(nc_home);
+    }
+#endif
     if (!set_boot_path('/', ':')) {
       vm_exit_during_initialization("Failed setting boot class path.", nullptr);
     }
